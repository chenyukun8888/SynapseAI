<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.chenyukun.synapse.module.agent.mapper.AgentWorkspaceMapper">

    <resultMap id="BaseResultMap" type="cn.chenyukun.synapse.module.agent.model.entity.AgentWorkspaceEntity">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="user_id" property="userId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM agent_workspace
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <select id="selectByAgentIdAndUserId" resultMap="BaseResultMap">
        SELECT * FROM agent_workspace
        WHERE agent_id = #{agentId}
        AND user_id = #{userId}
        LIMIT 1
    </select>

</mapper>

