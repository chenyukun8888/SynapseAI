# 开发环境配置模板
# 复制此文件为 application-dev.yml 并填写实际配置

# LLM 配置
llm:
  siliconflow:
    # 请在此处填写你的 SiliconFlow API Key
    # 获取地址：https://cloud.siliconflow.cn/account/ak
    api-key: YOUR_SILICONFLOW_API_KEY_HERE
    
    # API 地址（默认即可）
    api-url: https://api.siliconflow.cn/v1/chat/completions
    
    # 默认模型
    # 可选模型：
    # - Qwen/Qwen2.5-7B-Instruct (通义千问 2.5)
    # - tencent/Hunyuan-MT-7B (腾讯混元)
    # - THUDM/glm-4-9b-chat (智谱 GLM-4)
    # - deepseek-ai/DeepSeek-V2.5 (DeepSeek)
    default-model: Qwen/Qwen2.5-7B-Instruct
    
    # 超时时间（毫秒）
    timeout: 60000

# 日志配置
logging:
  level:
    root: info
    cn.chenyukun.synapse: debug
    cn.chenyukun.synapse.infrastructure.external.llm: debug

